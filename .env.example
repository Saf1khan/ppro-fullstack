# ==============================================================================
# PadosiPro Full-Stack Assignment - Environment Variables
# Copy this file to .env and adjust variables as needed for your local environment.
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=padosipro
POSTGRES_PASSWORD=padosipro_dev_password
POSTGRES_DB=padosipro_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Database Connection URLs
# Asyncpg driver used by FastAPI application runtime
DATABASE_URL=postgresql+asyncpg://padosipro:padosipro_dev_password@localhost:5432/padosipro_db
# Sync driver used for synchronous tooling / administrative tasks if required
DATABASE_URL_SYNC=postgresql://padosipro:padosipro_dev_password@localhost:5432/padosipro_db

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="PadosiPro Full-Stack API"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["*"]

# Security & Authentication (Phase 2)
# Secret key used for signing JWT access tokens (minimum 32 characters in production)
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Security Configuration
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Secret salt used for HMAC-SHA256 OTP hashing (never stored plaintext in DB)
OTP_SECRET_SALT=padosipro_otp_salt_dev_key_secure_2026

# SMTP / Email Configuration (Mailpit local service)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False
EMAILS_FROM_EMAIL=no-reply@padosipro.local
EMAILS_FROM_NAME="PadosiPro"

# Mobile App (Expo)
# Use 10.0.2.2:8000 for Android Emulator, or your LAN IP (e.g. 192.168.x.x:8000) for physical device
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
