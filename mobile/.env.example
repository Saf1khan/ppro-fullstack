# PadosiPro Mobile App Environment Variables
#
# Default behavior (when left blank):
# - Android Emulator: connects to http://10.0.2.2:8000/api/v1
# - iOS Simulator / Web: connects to http://localhost:8000/api/v1
#
# For physical device testing over LAN or production backend:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8000/api/v1
EXPO_PUBLIC_API_URL=
